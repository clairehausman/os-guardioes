    "web": "vite --host 0.0.0.0"
  },
  "dependencies": {
    "json-server": "^0.17.4",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "vite": "^6.0.0",
    "concurrently": "^9.1.0"
  }
}